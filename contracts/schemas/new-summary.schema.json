{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate-challenger.local/schemas/new-summary.schema.json",
  "title": "New Summary bilingual result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "title", "versions"],
  "properties": {
    "schema_version": {
      "const": "new-summary-v4"
    },
    "language": {
      "const": "en",
      "description": "The first Summary version is always English."
    },
    "title": {
      "type": "string",
      "pattern": "^AI Summary .+",
      "description": "Document title: AI Summary <initiative title>."
    },
    "versions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/version" },
            {
              "type": "object",
              "properties": { "language": { "const": "en" } }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/version" },
            {
              "type": "object",
              "properties": { "language": { "const": "ru" } }
            }
          ]
        }
      ],
      "items": false,
      "description": "Exactly two complete Summary versions: English first, Russian second."
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "stage",
        "traction_summary",
        "context",
        "required_elements"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["en", "ru"]
        },
        "stage": {
          "type": "string",
          "enum": [
            "Gate 1",
            "Gate 2",
            "Gate 3",
            "Progress Review",
            "Stream Review 1",
            "Stream Review 2+",
            "Stream Review 2+ / Progress Review",
            "Unknown"
          ]
        },
        "traction_summary": {
          "$ref": "#/$defs/traction_summary"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "description": "Up to six complete, readable sentences explaining the initiative, problem, target product, stage and past pilots. Apply the skill's terminology glossary."
        },
        "required_elements": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/required_element" },
          "description": "The exact stage checklist, in canonical order. Do not add criteria from other stages."
        },
        "critical_problems": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/critical_problem" },
          "description": "Zero to ten source-grounded problems not covered, even indirectly, by required elements. Do not paraphrase duplicate facts or report spreadsheet parsing errors such as REF/NAME. Each has one short issue sentence and one supporting fact; no recommendations."
        }
      }
    },
    "critical_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "fact"],
      "properties": {
        "issue": {
          "$ref": "#/$defs/non_empty_string",
          "description": "One short sentence stating the problem. Renderers make this text bold; do not include Markdown formatting."
        },
        "fact": {
          "$ref": "#/$defs/non_empty_string",
          "description": "One short, source-grounded sentence explaining the fact behind the problem."
        }
      }
    },
    "traction_summary": { "$ref": "#/$defs/traction_tables" },
    "traction_tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/traction_table" }
        }
      }
    },
    "traction_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "metric_label", "periods", "rows"],
      "properties": {
        "metric": { "type": "string", "enum": ["revenue", "dtb"] },
        "metric_label": { "$ref": "#/$defs/non_empty_string" },
        "cumulative": {
          "type": "boolean",
          "description": "True only for explicitly cumulative DTB in the source. Its Total cell is a dash, never a sum."
        },
        "periods": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/non_empty_string" },
          "description": "Align Revenue and DTB to common periods, starting at the later shared period and using the same granularity. Keep each table's own later ending periods. If only H2 is available for DTB, place its value under the matching year with an explicit (H2 YYYY) note in the cell. Otherwise never relabel partial-year values as annual or calculate annual values. Last column is Total for the displayed horizon. Plain text only."
        },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/traction_row" } }
      }
    },
    "traction_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "values"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Values must be in the same order as periods. New reports explain missing source values in the corresponding cell; older reports may use an empty string."
        }
      }
    },
    "required_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "gate1_market_opportunity_sizing",
            "gate1_initial_traction",
            "gate1_hypotheses_with_metrics",
            "gate2_value_proposition",
            "gate2_hypothesis_results",
            "gate2_target_product",
            "gate2_metric_linkage",
            "gate2_user_flow",
            "gate2_commitments",
            "gate2_stop_criteria",
            "gate3_working_mvp",
            "gate3_pmf_criteria",
            "gate3_stop_criteria",
            "gate3_solution_hypothesis_validation",
            "gate3_performance_vs_gate2_plan",
            "stream_review_1_confirmed_problem",
            "stream_review_1_input_output_metric_link",
            "stream_review_1_half_year_plan_with_metrics",
            "stream_review_1_stop_criteria",
            "stream_review_1_solution_validation",
            "progress_review_next_half_year_plan",
            "progress_review_stop_criteria",
            "progress_review_plan_fact_last_half_year",
            "stream_review_2_plus_next_half_year_plan",
            "stream_review_2_plus_stop_criteria",
            "stream_review_2_plus_plan_fact_last_half_year",
            "unknown_document_type",
            "unknown_source_materials"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "anyOf": [
            { "enum": ["есть", "частично подтверждено", "нет"] },
            { "pattern": "^[0-9]+/[0-9]+$" }
          ],
          "description": "Use есть/частично подтверждено/нет. Gate 2 hypotheses and Stream Review 1 solution checks may use a technical numerator/denominator; visible headings always count detail.items verdicts instead of showing the fraction when items exist. Gate 2 and Stream Review 1 metric linkage is есть only when at least 80 percent of listed input/output metrics have confirmed binding."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "One to three short source-grounded sentences in natural language; prefer fewer. For stop criteria, describe the strongest explicit stopping criterion and whether it is clearly defined, with the remaining criteria in detail.criteria."
        },
        "detail": {
          "$ref": "#/$defs/required_detail",
          "description": "Structured details displayed immediately below this required element, not in Appendices."
        }
      }
    },
    "required_detail": {
      "oneOf": [
        { "$ref": "#/$defs/hypotheses_with_thresholds_detail" },
        { "$ref": "#/$defs/solution_validation_detail" },
        { "$ref": "#/$defs/metric_binding_detail" },
        { "$ref": "#/$defs/next_review_plan_detail" },
        { "$ref": "#/$defs/plan_fact_detail" },
        { "$ref": "#/$defs/source_links_detail" },
        { "$ref": "#/$defs/criteria_list_detail" },
        { "$ref": "#/$defs/stop_criteria_detail" }
      ]
    },
    "hypotheses_with_thresholds_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "hypotheses_with_thresholds" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hypothesis_with_threshold_item" }
        }
      }
    },
    "hypothesis_with_threshold_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "confirmation_condition"],
      "properties": {
        "hypothesis": { "$ref": "#/$defs/non_empty_string" },
        "confirmation_condition": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "solution_validation_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "solution_validation" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/solution_validation_item" },
          "description": "List confirmed items first, then insufficient items. The visible Gate 2 heading uses X confirmed, Y total and Z insufficient from this array."
        }
      }
    },
    "solution_validation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "verdict"],
      "properties": {
        "text": {
          "$ref": "#/$defs/non_empty_string",
          "description": "For Gate 2 hypotheses and Stream Review 1 solution checks, one concise sentence per item, including why it is confirmed or insufficiently confirmed. No separate test/expected/actual paragraphs. Do not repeat the localized verdict in text."
        },
        "verdict": {
          "type": "string",
          "enum": ["confirmed", "insufficient"]
        }
      }
    },
    "metric_binding_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "input_metrics", "output_metrics"],
      "properties": {
        "type": { "const": "metric_binding" },
        "input_metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric_binding_item" }
        },
        "output_metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric_binding_item" }
        }
      }
    },
    "metric_binding_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "binding", "evidence"],
      "properties": {
        "metric": { "$ref": "#/$defs/non_empty_string" },
        "binding": {
          "type": "string",
          "enum": ["confirmed", "insufficient"],
          "description": "Relevance to the product/problem/UTP, not empirical validation or attainment of the metric target. A theoretically relevant metric can have confirmed binding even without a completed test."
        },
        "evidence": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "next_review_plan_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "outputs_until_next_review", "metrics_until_next_review"],
      "properties": {
        "type": { "const": "next_review_plan" },
        "outputs_until_next_review": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "metrics_until_next_review": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric_plan_row" }
        }
      }
    },
    "metric_plan_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "current", "next_review"],
      "properties": {
        "metric": { "$ref": "#/$defs/non_empty_string" },
        "current": { "type": "string" },
        "next_review": { "type": "string", "description": "Target value with the next review date or quarter when supplied by the source." }
      }
    },
    "stop_criteria_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "criteria"],
      "properties": {
        "type": { "const": "stop_criteria" },
        "criteria": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "criteria_list_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "criteria"],
      "properties": {
        "type": { "const": "criteria_list" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "description": "Gate 3 product-market fit criteria, displayed as a numbered list."
        }
      }
    },
    "plan_fact_detail": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "launches", "metrics"],
      "properties": {
        "type": { "const": "plan_fact" },
        "launches": { "type": "array", "items": { "$ref": "#/$defs/launch_fact" } },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric_fact" } }
      }
    },
    "launch_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["output", "status"],
      "properties": {
        "output": { "$ref": "#/$defs/non_empty_string" },
        "status": { "enum": ["completed", "partial", "not_completed", "unknown"] },
        "comment": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "metric_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "planned", "actual"],
      "properties": {
        "metric": { "$ref": "#/$defs/non_empty_string" },
        "planned": { "type": "string" },
        "actual": { "type": "string" }
      }
    },
    "source_links_detail": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "availability", "links"],
      "properties": {
        "type": { "const": "source_links" },
        "availability": { "enum": ["provided", "absent", "unavailable"] },
        "links": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "url"],
            "properties": {
              "label": { "$ref": "#/$defs/non_empty_string" },
              "url": { "type": "string", "pattern": "^https?://", "description": "Exact URL copied from the source document. Never construct or guess URLs." }
            }
          }
        }
      }
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
